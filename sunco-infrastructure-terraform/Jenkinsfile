pipeline {
    agent any

    environment {
        // Repository structure
        PROJECT_DIR = 'sunco-infrastructure-terraform'
        APP_DIR     = "${PROJECT_DIR}/app"
        TF_DIR      = "${PROJECT_DIR}/terraform"
        K8S_DIR     = "${PROJECT_DIR}/k8s"

        // AWS / ECR
        AWS_REGION   = 'ap-southeast-1'
        AWS_ACCOUNT  = '162956753889'
        ECR_REPO     = 'sunco'

        // Image details
        IMAGE_TAG    = "${BUILD_NUMBER}"
        ECR_REGISTRY = "${AWS_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_NAME   = "${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Gitleaks Scan') {
            steps {
                sh '''
                    gitleaks detect \
                      --source "$PROJECT_DIR" \
                      --verbose
                '''
            }
        }

        stage('Checkov Scan') {
            steps {
                sh '''
                    checkov -d "$TF_DIR"
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        npm ci
                    '''
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        npm test
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        docker build \
                          -t "$IMAGE_NAME" \
                          .
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      "$IMAGE_NAME"
                '''
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password \
                      --region "$AWS_REGION" \
                    | docker login \
                      --username AWS \
                      --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    docker push "$IMAGE_NAME"
                '''
            }
        }
    }

    post {

        success {
            echo "CI SUCCESS"
            echo "Docker image pushed to ECR:"
            echo "${IMAGE_NAME}"
        }

        failure {
            echo "CI FAILED"
        }

        always {
            sh '''
                docker logout "$ECR_REGISTRY" || true
            '''
        }
    }
}
