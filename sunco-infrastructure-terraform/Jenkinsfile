pipeline {
    agent any

    environment {
        // Project directories
        PROJECT_DIR = 'sunco-infrastructure-terraform'
        APP_DIR     = "${PROJECT_DIR}/app"
        TF_DIR      = "${PROJECT_DIR}/terraform"
        K8S_DIR     = "${PROJECT_DIR}/k8s"

        // AWS / ECR
        AWS_REGION  = 'ap-southeast-1'
        AWS_ACCOUNT = '162956753889'
        ECR_REPO    = 'sunco'

        // Docker image
        IMAGE_TAG    = "${BUILD_NUMBER}"
        ECR_REGISTRY = "${AWS_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_NAME   = "${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Gitleaks Scan') {
            steps {
                sh '''
                    gitleaks detect \
                      --source "$PROJECT_DIR" \
                      --verbose
                '''
            }
        }

        stage('Checkov Scan') {
            steps {
                catchError(
                    buildResult: 'SUCCESS',
                    stageResult: 'UNSTABLE'
                ) {
                    sh '''
                        /opt/checkov-venv/bin/checkov \
                          -d "$TF_DIR" \
                          --framework terraform
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        npm ci
                    '''
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        npm test
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        docker build \
                          -t "$IMAGE_NAME" \
                          .
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      "$IMAGE_NAME"
                '''
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    /usr/local/bin/aws ecr get-login-password \
                      --region "$AWS_REGION" \
                    | docker login \
                      --username AWS \
                      --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    docker push "$IMAGE_NAME"
                '''
            }
        }

        stage('Update GitOps Image Tag') {
            steps {
                sh '''
                    cd "$K8S_DIR"

                    sed -i "s|image: .*sunco:.*|image: $IMAGE_NAME|" deployment.yaml

                    git config user.name "jenkins"
                    git config user.email "jenkins@sunco.local"

                    git add deployment.yaml

                    if ! git diff --cached --quiet; then
                        git commit -m "Deploy Sunco image ${IMAGE_TAG}"
                        git push origin HEAD:main
                    else
                        echo "No GitOps manifest changes detected"
                    fi
                '''
            }
        }
    }

    post {

        success {
            echo "====================================="
            echo "SUNCO CI PIPELINE SUCCESSFUL"
            echo "Image: ${IMAGE_NAME}"
            echo "GitOps manifest updated for Argo CD"
            echo "====================================="
        }

        failure {
            echo "SUNCO CI PIPELINE FAILED"
        }

        always {
            sh '''
                docker logout "$ECR_REGISTRY" || true
            '''
        }
    }
}
